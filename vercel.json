{
    "cleanUrls":  true,
    "trailingSlash":  false,
    "outputDirectory":  "public",
    "buildCommand":  "npm run build:real",
    "installCommand":  null,
    "framework":  null,
    "headers":  [
                    {
                        "source":  "/assets/(.*)",
                        "headers":  [
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "public, max-age=31536000, immutable"
                                        }
                                    ]
                    },
                    {
                        "source":  "/(.*).html",
                        "headers":  [
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "public, max-age=0, must-revalidate"
                                        }
                                    ]
                    },
                    {
                        "source":  "/styles.css",
                        "headers":  [
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "public, max-age=31536000, immutable"
                                        }
                                    ]
                    },
                    {
                        "source":  "/app.js",
                        "headers":  [
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "public, max-age=31536000, immutable"
                                        }
                                    ]
                    },
                    {
                        "source":  "/qrcode.js",
                        "headers":  [
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "public, max-age=31536000, immutable"
                                        }
                                    ]
                    }
                ],
    "rewrites":  [
                     {
                         "source":  "/(.*)",
                         "destination":  "/index.html"
                     }
                 ]
}